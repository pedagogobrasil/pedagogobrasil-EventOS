{
  "name": "pedagogobrasil/eventos",
  "description": "Open-source platform for managing charity events, bingo, raffles, donations and community fundraising.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "monolog/monolog": "^3.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "EventOS\\": "app/",
      "EventOS\\Modules\\": "modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": "php-cs-fixer fix --diff",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "post-autoload-dump": [
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\"",
      "@php -r \"is_dir('storage/cache') || mkdir('storage/cache', 0775, true);\""
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
